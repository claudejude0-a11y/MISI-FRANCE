# En-têtes HTTP — format Cloudflare Pages (ce fichier est copié tel quel dans out/).
# ⚠️ Spécifique à Cloudflare Pages. Sur un hébergement Apache (OVH / IONOS mutualisé),
# ces règles doivent être portées dans un fichier .htaccess à la racine du site.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Assets fingerprintés par Next — cache long et immuable.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache d'un mois (renommer le fichier pour forcer un rafraîchissement).
/images/*
  Cache-Control: public, max-age=2592000
